# Ghostty: https://ghostty.org/docs/config

command = /usr/bin/fish --login --interactive
shell-integration = fish

theme = Vesper
font-family = JetBrainsMono Nerd Font

mouse-scroll-multiplier = 0.5

window-decoration = true
window-padding-x = 8
window-padding-y = 8

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1B7=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
